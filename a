<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For Mellow ❤️</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Nunito:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    
    <style>
        body {
            background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
            background-color: #ffdde1; 
            background-image: linear-gradient(0deg, #ffdde1 0%, #ee9ca7 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Nunito', sans-serif;
            overflow: hidden; /* Prevents scrollbars when button moves */
        }

        .card {
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            max-width: 500px;
            padding: 2rem;
            text-align: center;
            transition: transform 0.3s ease;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        h1 {
            font-family: 'Dancing Script', cursive;
            color: #d63384;
            font-size: 3.5rem;
            margin-bottom: 1rem;
        }

        .pet-name {
            color: #fd7e14; /* Orange for Mellow */
            font-weight: bold;
        }

        .lead {
            font-size: 1.2rem;
            color: #555;
            margin-bottom: 2rem;
        }

        .btn-lg {
            padding: 12px 40px;
            font-size: 1.2rem;
            border-radius: 50px;
            font-weight: bold;
            transition: all 0.3s;
        }

        #yesBtn {
            background-color: #d63384;
            border-color: #d63384;
            box-shadow: 0 4px 15px rgba(214, 51, 132, 0.4);
        }

        #yesBtn:hover {
            background-color: #b02a6b;
            transform: scale(1.1);
        }

        #noBtn {
            background-color: #6c757d;
            border-color: #6c757d;
            position: relative; /* Changed dynamically via JS */
        }

        /* Success Message Hidden Initially */
        #successMessage {
            display: none;
        }
        
        .heart-beat {
            animation: heartbeat 1.5s infinite;
            color: #ff0000;
            font-size: 3rem;
            margin-bottom: 10px;
            display: block;
        }

        @keyframes heartbeat {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }

        .funny-note {
            font-size: 0.9rem;
            color: #888;
            margin-top: 10px;
            font-style: italic;
        }
    </style>
</head>
<body>

    <div class="container d-flex justify-content-center">
        <div class="card text-center" id="mainCard">
            <span class="heart-beat">❤️</span>
            <h1>Hey Himali!</h1>
            
            <div id="questionArea">
                <p class="lead">
                    To my dearest <span class="pet-name">Mellow</span>,<br><br>
                    I was going to write a poetic masterpiece, but I realized I'm better at coding than rhyming. 
                    <br><br>
                    So, strictly logically speaking, you are the CSS to my HTML. Without you, I'm just unstyled structure! 
                </p>
                <hr>
                <h3 class="mb-4">Will you be mine forever?</h3>
                
                <div class="d-flex justify-content-center gap-3" style="position: relative; min-height: 60px;">
                    <button class="btn btn-primary btn-lg text-white" id="yesBtn">YES! 😍</button>
                    <button class="btn btn-secondary btn-lg" id="noBtn">No 😢</button>
                </div>
                <p class="funny-note">(Don't even try the gray button, Mellow. It's slippery.)</p>
            </div>

            <div id="successMessage">
                <h2 class="text-danger mb-3">YAY! She said YES! 🎉</h2>
                <p class="lead">Best decision you've ever made, Mellow! <br> I love you so much! ❤️</p>
                <img src="https://media.giphy.com/media/26BRv0ThflsHCqDrG/giphy.gif" alt="Happy Dance" style="width: 100%; border-radius: 15px; max-width: 300px;">
                <br><br>
                <p class="text-muted small">Happy Propose Day!</p>
            </div>
        </div>
    </div>

    <script>
        const yesBtn = document.getElementById('yesBtn');
        const noBtn = document.getElementById('noBtn');
        const questionArea = document.getElementById('questionArea');
        const successMessage = document.getElementById('successMessage');
        const mainCard = document.getElementById('mainCard');

        // Function to move the "No" button
        function moveButton() {
            // Get viewport dimensions
            const maxWidth = window.innerWidth - noBtn.offsetWidth;
            const maxHeight = window.innerHeight - noBtn.offsetHeight;

            // Generate random position
            const randomX = Math.floor(Math.random() * maxWidth);
            const randomY = Math.floor(Math.random() * maxHeight);

            // Apply new position
            noBtn.style.position = 'fixed'; // Change to fixed to allow movement anywhere on screen
            noBtn.style.left = randomX + 'px';
            noBtn.style.top = randomY + 'px';
        }

        // Add Event Listeners for Desktop (Mouse over) and Mobile (Touch start)
        noBtn.addEventListener('mouseover', moveButton);
        noBtn.addEventListener('touchstart', (e) => {
            e.preventDefault(); // Prevent clicking on mobile
            moveButton();
        });
        noBtn.addEventListener('click', (e) => {
             e.preventDefault();
             moveButton();
        });

        // Function for the "Yes" button click
        yesBtn.addEventListener('click', () => {
            // Hide the question
            questionArea.style.display = 'none';
            // Show the success message
            successMessage.style.display = 'block';
            
            // Trigger Confetti
            fireConfetti();
        });

        // Confetti Effect function
        function fireConfetti() {
            var duration = 5 * 1000;
            var animationEnd = Date.now() + duration;
            var defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };

            function randomInRange(min, max) {
            return Math.random() * (max - min) + min;
            }

            var interval = setInterval(function() {
            var timeLeft = animationEnd - Date.now();

            if (timeLeft <= 0) {
                return clearInterval(interval);
            }

            var particleCount = 50 * (timeLeft / duration);
            // since particles fall down, start a bit higher than random
            confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
            confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
            }, 250);
        }
    </script>
</body>
</html>
